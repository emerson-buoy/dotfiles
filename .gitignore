.zshrc

aliases/*.local.sh

aliases/chrome.json


src/go/**/*
!src/go/**/*.go
!src/go/**/*.sh
!src/go/**/
!src/go/**/go.mod

*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# ignore all env files in all folders
**/*.env
**/*.env.local
**/*.env.development.local
**/*.env.test.local
**/*.env.production.local

# standard python gitignore for venv etc
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/

# all .ds_store files
.DS_Store
